# Per-machine editor and agent settings. .kiro/settings can hold MCP server tokens, and .kiro/gcp-project.json names a
# billing project that only this machine's gcloud login can use (copy .kiro/gcp-project.example.json to create it).
.kiro/settings/
.kiro/gcp-project.json
# The production runbook and scripts. They name this deployment's cloud account and resources, so they stay out of the
# public repository.
deploy/
# Local test photos. Phone photos carry GPS and device metadata.
_testers/
# Stray curl cookie jars: `curl -c <name>` run with an HTTP status as the name leaves bare three-digit files in the root.
/[0-9][0-9][0-9]
# Full-quality PLY intermediates of the object-split demo (107.5 MB). The page works without them; see
# "Hosting it" in demo/object-split/README.md. To keep them in the repository, remove this line (or track them with Git LFS).
demo/object-split/parts/splats/ply/*.ply
