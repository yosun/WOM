# Meta Model API key (Muse Spark, Muse Wonder, Muse Image, SAM 3.1): https://dev.meta.ai
MUSE_API_KEY=
# AI3D API key (MoGe-2, Tripo, World Labs Marble): https://api.ai3d.dev/v2
AI3D_API_KEY=

# OpenAI key for experimental GPT-6.1 Sol planning/placement and the GPT-6.1 Terra patrol judge.
# Set this in the deployment's server environment or in .env locally. Never expose it to Vite/browser code.
OPENAI_API_KEY=
# Legacy alias, still accepted. OPENAI_API_KEY takes priority when both are set.
OPENAI_KEY=
# Gemini API key for the patrol's Gemini 3.8 Flash judge: https://aistudio.google.com/apikey
# Works on any machine. Without it, the judge uses Vertex AI in the project named by .kiro/gcp-project.json (copy
# .kiro/gcp-project.example.json), through the local gcloud login.
GEMINI_API_KEY=

# Sign-in (Clerk). It is required on any server other machines can reach (HOST is not 127.0.0.1, localhost or ::1),
# and off on localhost. Set WOM_AUTH=required on a production server, including one behind a reverse proxy on the same
# machine, so sign-in cannot be left off. Keys: https://dashboard.clerk.com, API keys page (pk_live_ and sk_live_ in production).
# WOM_AUTH=required
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Exact origins the app is served from, comma-separated (wildcards are not supported). Defaults to localhost on PORT and 5173.
# CLERK_AUTHORIZED_PARTIES=https://wom.quest

# Postgres. Schema: db/migrations/. scripts/db-roles.mjs creates the first two from DATABASE_URL_ADMIN, so only the admin
# URL is pasted by hand.
#   DATABASE_URL         wom_app, pooled. The API and build worker. Row-level security applies.
#   DATABASE_URL_SYSTEM  wom_system, pooled. The Stripe webhook and admin tools.
#   DATABASE_URL_ADMIN   wom_owner, direct. Migrations only. Never deploy it.
DATABASE_URL=
DATABASE_URL_SYSTEM=
DATABASE_URL_ADMIN=
# Stripe (credit packs). The server holds no Stripe API key. The packs are Payment Links made by scripts/stripe-packs.mjs
# (listed in server/src/packs.json), and Stripe tells the server who paid through a signed webhook, so the only value needed is
# that webhook endpoint's signing secret. On a server, keep it in the server's secret store, not in a file. Without it, no
# packs are offered. Locally, `stripe listen --forward-to localhost:8787/api/stripe/webhook` prints a whsec_ value for this.
STRIPE_WEBHOOK_SECRET=

# Optional
# PORT=8787
# HOST=127.0.0.1
# WOM_STORE=postgres
# WOM_PUBLIC_ORIGIN=https://wom.quest
# Credits a world costs someone who is not an administrator (default 500). Needs WOM_STORE=postgres.
# WOM_WORLD_CREDITS=500
# WOM_DATA_DIR=./data
# WOM_MAX_PARALLEL_MESH_JOBS=4
# HEIC uploads: macOS ImageIO on a Mac, libheif (Python + pillow-heif) elsewhere.
# WOM_HEIC_DECODER=imageio
# WOM_HEIC_PYTHON=python3
# Connections per Postgres pool (default 5).
# WOM_DB_POOL=5
# Other endpoints for the model clients (the defaults are shown).
# MUSE_BASE_URL=https://api.meta.ai/v1
# AI3D_BASE_URL=https://api.ai3d.dev/v2
# Vertex AI judge, used when GEMINI_API_KEY is empty: the gcloud program to run, and the Vertex location (default global).
# GCLOUD_BIN=gcloud
# GEMINI_LOCATION=global
# Aliases: MODEL_API_KEY is read when MUSE_API_KEY is empty, and OPENAI_KEY when OPENAI_API_KEY is empty.
