{
  "name": "world-of-a-memory",
  "version": "0.1.0",
  "private": true,
  "description": "WOMetrics: World Observation Metrics for reconstructed 3D worlds, with the WOMPar reference pipeline and a standalone one-key evaluation demo.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "demo:wompar": "node demo/wompar/wompar.mjs",
    "demo:wompar:offline": "node demo/wompar/wompar.mjs --offline",
    "test:demo:wompar": "node --test demo/wompar/wompar.test.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch-path=server/src --watch-path=packages/metrics/src --env-file-if-exists=.env server/src/index.ts",
    "dev:web": "vite",
    "build": "vite build && node scripts/build-wompar-public.mjs",
    "start": "vite build && node --env-file-if-exists=.env server/src/index.ts",
    "serve": "node --env-file-if-exists=.env server/src/index.ts",
    "db:import-worlds": "node scripts/import-worlds.mjs",
    "promo": "node --env-file-if-exists=.env scripts/promo.ts",
    "bench:placement": "node --env-file-if-exists=.env scripts/bench-placement.ts",
    "bench:par": "node --env-file-if-exists=.env scripts/bench-par.ts",
    "bench:par:review": "node --env-file-if-exists=.env scripts/review-par.ts",
    "bench:global": "node --env-file-if-exists=.env scripts/bench-global.ts",
    "bench:global:freeze": "node scripts/freeze-par.ts",
    "test:par": "node --test scripts/tests/par.test.ts",
    "test:setup": "node --test scripts/tests/setup.test.ts",
    "test:wometrics:ui": "node scripts/tests/wometrics-ui.mjs",
    "test:home-demo": "node scripts/tests/home-demo-ui.mjs",
    "test:videos": "node --test scripts/tests/videos.test.ts",
    "test:llm": "node --test scripts/tests/llm.test.ts",
    "test:placement": "node --test scripts/tests/placement.test.ts",
    "test:wometrics": "node --test scripts/tests/wometrics.test.ts",
    "bench:assets": "node --env-file-if-exists=.env scripts/bench-assets.ts",
    "bench:patrol": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/bench-patrol.ts",
    "slides:video": "node scripts/slides/video.mjs",
    "slides:e2e": "node scripts/slides/e2e.mjs",
    "slides:input": "node scripts/slides/input.mjs",
    "slides:seam": "node scripts/slides/seam.mjs",
    "slides:visual": "node scripts/slides/visual.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json && npm run typecheck -w @wom/metrics"
  },
  "dependencies": {
    "@clerk/backend": "^3.26.6",
    "@clerk/clerk-js": "^6.42.2",
    "@clerk/ui": "^1.42.3",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@hono/node-server": "^2.1.5",
    "@meta-sam/parser": "^0.1.0",
    "@sparkjsdev/spark": "^2.4.0",
    "@wom/metrics": "*",
    "exifr": "^7.1.3",
    "hono": "^4.13.16",
    "meshoptimizer": "^1.3.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "stripe": "^23.1.0",
    "three": "^0.187.0",
    "three-mesh-bvh": "^0.9.17"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
