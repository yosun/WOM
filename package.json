{
  "name": "world-of-a-memory",
  "version": "0.1.0",
  "private": true,
  "description": "World of a Memory (WOM): turn a single photo into an explorable 3D world with Muse Spark, SAM 3.1, Muse Image, MoGe-2, Tripo and World Labs.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch-path=server/src --env-file-if-exists=.env server/src/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "vite build && node --env-file-if-exists=.env server/src/index.ts",
    "serve": "node --env-file-if-exists=.env server/src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@hono/node-server": "^2.1.5",
    "@meta-sam/parser": "^0.1.0",
    "@sparkjsdev/spark": "^2.4.0",
    "hono": "^4.13.16",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
